    "import.description": {
      "comment": "Bulk import help text",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个目标或网段，可写成「目标」或「目标 备注」。支持 10.0.0.0/24、10.0.0.1-10.0.0.254、10.0.0.1-254；单个网段最多 1024 个地址。以 # 开头的行会被忽略；重复或格式非法的行会被跳过并列出原因。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One target or range per line, written as “target” or “target note”. Supports 10.0.0.0/24, 10.0.0.1-10.0.0.254, and 10.0.0.1-254; a single range supports up to 1024 addresses. Lines starting with # are ignored; duplicate or invalid lines are skipped and listed with reasons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 つのターゲットまたは範囲を「ターゲット」または「ターゲット メモ」の形式で入力します。10.0.0.0/24、10.0.0.1-10.0.0.254、10.0.0.1-254 に対応し、1 つの範囲は最大 1024 アドレスまでです。# で始まる行は無視され、重複または不正な行はスキップされて理由が表示されます。"
          }
        }
      }
    },
    "import.mode.append.description": {
      "comment": "Bulk import append mode description",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留现有 %lld 个目标，把导入的内容追加到末尾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep existing targets (%lld) and append the imported content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のターゲット（%lld 件）を保持し、インポート内容を末尾に追加します。"
          }
        }
      }
    },
