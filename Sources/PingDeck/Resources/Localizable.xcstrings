    "range.ipv6Unsupported": {
      "comment": "IP range parsing: IPv6 CIDR unsupported",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持 IPv6 网段，请填写 IPv4 网段"
