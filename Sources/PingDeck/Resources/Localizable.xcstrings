{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "app.name.smoke": {
      "comment": "Build-time smoke test for generated String Catalog symbols.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PingDeck"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PingDeck"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PingDeck"
          }
        }
      }
    },
    "validation.empty": {
      "comment": "Target validation: empty input",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标不能为空"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target cannot be empty"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲットを入力してください"
          }
        }
      }
    },
    "validation.protocolPrefix": {
      "comment": "Target validation: protocol prefix",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请不要填写协议前缀，例如 http://"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include a protocol prefix such as http://"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// などのプロトコル接頭辞は入力しないでください"
          }
        }
      }
    },
    "validation.path": {
      "comment": "Target validation: path in host",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只填写主机名或 IP，不要带路径"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter only a hostname or IP, without a path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト名または IP のみを入力し、パスは含めないでください"
          }
        }
      }
    },
    "validation.whitespace": {
      "comment": "Target validation: whitespace in host",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标不能包含空格"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target cannot contain spaces"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲットにスペースは使用できません"
          }
        }
      }
    },
    "validation.invalidCharacters": {
      "comment": "Target validation: invalid characters",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标包含非法字符"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target contains invalid characters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲットに使用できない文字が含まれています"
          }
        }
      }
    },
    "range.ipv6Unsupported": {
      "comment": "IP range parsing: IPv6 CIDR unsupported",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持 IPv6 网段，请填写 IPv4 网段"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv6 ranges are not supported yet; enter an IPv4 range"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv6 の範囲はまだサポートされていません。IPv4 の範囲を入力してください"
          }
        }
      }
    },
    "range.malformedCIDR": {
      "comment": "IP range parsing: malformed CIDR",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：请写成 10.0.0.0/24 这样的 CIDR"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid range format: use CIDR such as 10.0.0.0/24"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲の形式が正しくありません。10.0.0.0/24 のような CIDR を入力してください"
          }
        }
      }
    },
    "range.cidrNotNetworkAddress": {
      "comment": "IP range parsing: CIDR host bits set",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：CIDR 请填写网络地址，例如 10.0.0.0/24"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid range format: CIDR must use a network address, e.g. 10.0.0.0/24"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲の形式が正しくありません。CIDR にはネットワークアドレスを指定してください（例：10.0.0.0/24）"
          }
        }
      }
    },
    "range.tooLarge": {
      "comment": "IP range parsing: range exceeds max addresses",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段过大：单个网段最多支持 %lld 个地址"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Range too large: max %lld addresses per range"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲が大きすぎます。1 つの範囲は最大 %lld アドレスまでです"
          }
        }
      }
    },
    "range.malformed": {
      "comment": "IP range parsing: malformed explicit range",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：请写成 10.0.0.1-10.0.0.254 或 10.0.0.1-254"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid range format: use 10.0.0.1-10.0.0.254 or 10.0.0.1-254"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲の形式が正しくありません。10.0.0.1-10.0.0.254 または 10.0.0.1-254 の形式で入力してください"
          }
        }
      }
    },
    "range.endBeforeStart": {
      "comment": "IP range parsing: end address before start",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：结束地址不能小于起始地址"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid range format: end address cannot be before start address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲の形式が正しくありません。終了アドレスは開始アドレスより前にできません"
          }
        }
      }
    },
    "import.rejected.duplicate": {
      "comment": "Bulk import: duplicate target",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与已有目标重复"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate of an existing target"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のターゲットと重複しています"
          }
        }
      }
    },
    "import.rejected.line": {
      "comment": "Bulk import: rejected line with line number, text and reason",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 行「%2$@」：%3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %1$lld “%2$@”: %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 行目「%2$@」：%3$@"
          }
        }
      }
    },
