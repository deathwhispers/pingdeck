    "settings.rotation.hint": {
      "comment": "Settings: rotation hint",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标数超过并发上限时，按该周期轮换探测，保证每个目标都被覆盖"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When targets exceed the concurrency limit, probes rotate at this interval so every target is covered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲット数が同時実行数の上限を超える場合、この間隔でローテーションしてすべてのターゲットをカバーします。"
          }
        }
      }
    },
