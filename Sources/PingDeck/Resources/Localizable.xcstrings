          }
        }
      }
    },
    "alert.concurrency.belowLimit": {
      "comment": "Concurrency adjustment message below limit",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 %1$lld 个启用目标，并发数从 %2$lld 提升到 %3$lld，以便同时监控所有目标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled targets: %1$lld. Concurrency raised from %2$lld to %3$lld so all targets can be monitored at once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なターゲット：%1$lld 件。すべてのターゲットを同時に監視できるよう、同時実行数を %2$lld から %3$lld に引き上げました。"
          }
        }
      }
    },
    "alert.concurrency.atLimit": {
      "comment": "Concurrency adjustment message at limit",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 %1$lld 个启用目标，并发数从 %2$lld 提升到 %3$lld（上限 %4$lld），其余目标将按轮换周期探测。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled targets: %1$lld. Concurrency raised from %2$lld to %3$lld (max %4$lld); remaining targets will rotate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なターゲット：%1$lld 件。同時実行数を %2$lld から %3$lld に引き上げました（上限 %4$lld）。残りのターゲットはローテーションで処理されます。"
          }
        }
      }
    },
