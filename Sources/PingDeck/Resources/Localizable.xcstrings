    "range.cidrNotNetworkAddress": {
      "comment": "IP range parsing: CIDR host bits set",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：CIDR 请填写网络地址，例如 10.0.0.0/24"
