    },
    "import.mode.replace.description.withCount": {
      "comment": "Bulk import replace mode description with existing targets",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 将丢弃现有 %lld 个目标（含备注与启用状态），只保留导入的内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Discard existing targets (%lld), including notes and enabled state; keep only the imported content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
