    "settings.interval.hint": {
      "comment": "Settings: interval hint",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "间隔越小数据越实时，CPU 与网络占用越高"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorter intervals give fresher data but use more CPU and network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔が短いほどリアルタイム性が上がりますが、CPU とネットワークの負荷も高くなります。"
          }
        }
      }
    },
    "settings.timeout": {
