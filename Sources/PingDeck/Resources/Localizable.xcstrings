    "range.tooLarge": {
      "comment": "IP range parsing: range exceeds max addresses",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段过大：单个网段最多支持 %lld 个地址"
