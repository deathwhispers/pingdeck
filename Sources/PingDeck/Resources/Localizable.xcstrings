    "settings.maxConcurrent.hint": {
      "comment": "Settings: max concurrency hint",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时运行的 ping 进程上限；启动时会自动提升到启用目标数量（最多 %lld）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper limit of simultaneous ping processes; it is raised automatically at startup to the number of enabled targets (max %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に実行する ping プロセスの上限です。起動時に有効なターゲット数まで自動的に引き上げられます（最大 %lld）。"
          }
        }
      }
    },
    "settings.rotation": {
      "comment": "Settings: rotation interval label",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换周期"
