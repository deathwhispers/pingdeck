    "range.malformedCIDR": {
      "comment": "IP range parsing: malformed CIDR",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：请写成 10.0.0.0/24 这样的 CIDR"
          }
        }
      }
