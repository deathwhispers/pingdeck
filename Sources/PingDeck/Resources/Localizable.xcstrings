    },
    "range.malformed": {
      "comment": "IP range parsing: malformed explicit range",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网段格式不正确：请写成 10.0.0.1-10.0.0.254 或 10.0.0.1-254"
          }
        }
      }
    },
    "range.endBeforeStart": {
      "comment": "IP range parsing: end address before start",
