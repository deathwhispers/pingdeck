    "settings.timeout.hint": {
      "comment": "Settings: timeout hint",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过该时间没有收到回包，状态显示为超时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no reply arrives within this time, the target is marked as timed out."
